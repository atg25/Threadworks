# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit it.

# --- Required in dev and prod ---

# OpenAI Chat Completions bearer token. Must have access to the model
# configured via `:openai_model` in config/config.exs (default "gpt-4o").
# Generate at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-REPLACE_ME

# --- Required in prod only (releases) ---

# Generate with: mix phx.gen.secret
# SECRET_KEY_BASE=REPLACE_ME

# Set to "true" inside the release env to actually boot the Phoenix endpoint.
# PHX_SERVER=true

# Canonical host used in generated URLs.
# PHX_HOST=chat.example.com

# DATABASE_PATH=/var/lib/chat_app/chat_app.db
# POOL_SIZE=5

# BASIC_AUTH_USER=admin
# BASIC_AUTH_PASSWORD=use-a-long-random-string

# --- Optional ---

# HTTP port (default 4000).
# PORT=4000

# DNS-based clustering query (see libcluster / dns_cluster docs).
# DNS_CLUSTER_QUERY=myapp.internal

# --- Required for eBay Marketplace integration ---

# eBay developer application ID — register at https://developer.ebay.com/
EBAY_APP_ID=REPLACE_ME

# eBay developer certificate ID — paired with EBAY_APP_ID
EBAY_CERT_ID=REPLACE_ME

# eBay REST API base URL (production or sandbox)
EBAY_API_BASE_URL=https://api.ebay.com

# --- Optional for Wallaby E2E tests on non-mac-arm64 hosts ---

# CHROMEDRIVER_PATH=/usr/local/bin/chromedriver
# CHROME_BINARY_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
